#!/bin/bash
# Neo — Light Engine Hermes. Matrix. Local shell + ssh server. Isolated HERMES_HOME.
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
export HERMES_HOME="$ROOT/.hermes-home"
WORK="$ROOT/work"
mkdir -p "$HERMES_HOME" "$WORK" "$HERMES_HOME/skins" "$HERMES_HOME/skills/acer-ssh"

if [[ -f "$HOME/.config/openrouter/api_key" ]]; then
  export OPENROUTER_API_KEY
  OPENROUTER_API_KEY="$(tr -d ' \t\r\n' < "$HOME/.config/openrouter/api_key")"
fi
if [[ -f "$HOME/Work/Projects/nvapi.key" ]]; then
  export NVIDIA_API_KEY NVAPI_KEY
  NVIDIA_API_KEY="$(tr -d ' \t\r\n' < "$HOME/Work/Projects/nvapi.key")"
  NVAPI_KEY="$NVIDIA_API_KEY"
fi

# llama.cpp is OpenAI-compatible. Hermes only allows <64k ctx if provider=lmstudio.
export LM_BASE_URL="http://192.168.1.10:8081/v1"
export LM_API_KEY="${LM_API_KEY:-lm-studio}"

umask 077
{
  printf 'LM_BASE_URL=%s\n' "$LM_BASE_URL"
  printf 'LM_API_KEY=%s\n' "$LM_API_KEY"
  [[ -n "${NVIDIA_API_KEY:-}" ]] && printf 'NVIDIA_API_KEY=%s\n' "$NVIDIA_API_KEY"
  [[ -n "${NVAPI_KEY:-}" ]] && printf 'NVAPI_KEY=%s\n' "$NVAPI_KEY"
  [[ -n "${OPENROUTER_API_KEY:-}" ]] && printf 'OPENROUTER_API_KEY=%s\n' "$OPENROUTER_API_KEY"
} > "$HERMES_HOME/.env"

# Hermes rewrites config.yaml on start. Pin local every launch.
PYTHON=""
for cand in "/home/warpuppy/.hermes/hermes-agent/venv/bin/python" "$(command -v python3)"; do
  if [[ -x "$cand" ]] && "$cand" -c 'import yaml' 2>/dev/null; then PYTHON="$cand"; break; fi
done
[[ -n "$PYTHON" ]] || { echo "no python with yaml" >&2; exit 1; }

# Share global Nous auth with this isolated home (read-write via symlink).
if [[ -f "$HOME/.hermes/auth.json" && ! -e "$HERMES_HOME/auth.json" ]]; then
  ln -s "$HOME/.hermes/auth.json" "$HERMES_HOME/auth.json"
fi

$PYTHON - "$HERMES_HOME/config.yaml" <<'PY'
import sys
from pathlib import Path
p = Path(sys.argv[1])
try:
    import yaml
except ImportError:
    raise SystemExit(0)
raw = p.read_text() if p.exists() else "{}"
data = yaml.safe_load(raw) or {}
data["model"] = {
    "default": "stealth/missingno",
    "provider": "nous",
    "base_url": "https://inference-api.nousresearch.com/v1",
    "context_length": 262144,
    "max_output_tokens": 4096,
}
data["compression"] = {"enabled": True, "threshold": 0.80}
aux = data.get("auxiliary") or {}
aux["free_only"] = True
aux["compression"] = {"context_length": 262144}
data["auxiliary"] = aux
data["approvals"] = {"mode": "off", "timeout": 30}
data.setdefault("platform_toolsets", {})["cli"] = ["file", "terminal"]
data["fallback_providers"] = [
    {"provider": "custom", "model": "openrouter/free", "base_url": "https://openrouter.ai/api/v1", "key_env": "OPENROUTER_API_KEY"},
]
p.write_text(yaml.safe_dump(data, sort_keys=False))
PY

STATE="${XDG_STATE_HOME:-$HOME/.local/state}"
mkdir -p "$STATE/clarity" "$STATE/omarchy/agents"
printf '%s\n' '{"mode":"local"}' > "$STATE/clarity/engine-mode.json"
printf '%s\n' '{"mode":"local"}' > "$STATE/omarchy/agents/panel-view.json"

printf '\033]0;Neo · Light Engine\007' || true
printf '\033[32m'
cat <<'EOF'

  WAKE UP, WARPUPPY.
  THE MATRIX HAS YOU.

      Neo · Light Engine
      Lenovo local  ·  acer via ssh server
      8B CPU 16k  ·  GPU 3B fallback

EOF
printf '\033[0m'

cd "$WORK"
exec hermes --tui --yolo --in "$WORK" "$@"
